    ]
   },
   "layout": {
    "visibility": "none"
   }
  },
  {
   "id": "hillshade",
   "type": "hillshade",
   "source": "dem",
   "paint": {
    "hillshade-exaggeration": 0.3,
    "hillshade-shadow-color": "#2a2f45",
