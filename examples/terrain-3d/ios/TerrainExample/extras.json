 "top": [
  {
   "id": "road-hit",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation",
   "minzoom": 10,
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "motorway",
      "trunk",
      "primary",
      "secondary",
      "tertiary",
      "minor",
      "service",
      "path",
      "track"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round"
   },
   "paint": {
    "line-color": "#ffffff",
    "line-opacity": 0.02,
    "line-width": 10
   }
  },
  {
   "id": "road-names",
   "type": "line",
   "source": "ofm",
   "source-layer": "transportation_name",
   "minzoom": 11,
   "layout": {
    "line-cap": "round"
   },
   "paint": {
    "line-color": "#ffffff",
    "line-opacity": 0.02,
    "line-width": 10
   }
  },
  {
   "id": "buildings",
   "type": "fill-extrusion",
   "source": "ofm",
   "source-layer": "building",
   "minzoom": 13,
   "paint": {
    "fill-extrusion-color": [
     "interpolate",
     [
      "linear"
     ],
     [
      "coalesce",
      [
       "get",
       "render_height"
      ],
      6
     ],
     0,
     "#e8dccb",
     20,
     "#d9a98a",
     45,
     "#b8785f"
    ],
    "fill-extrusion-height": [
     "coalesce",
     [
      "get",
      "render_height"
     ],
     6
    ],
    "fill-extrusion-base": [
     "coalesce",
     [
      "get",
      "render_min_height"
     ],
     0
    ],
    "fill-extrusion-opacity": 0.95,
    "fill-extrusion-vertical-gradient": true
   },
   "layout": {
    "visibility": "none"
   }
  },
  {
   "id": "peak-heat",
   "type": "heatmap",
   "source": "ofm",
   "source-layer": "mountain_peak",
   "paint": {
    "heatmap-weight": [
     "interpolate",
     [
      "linear"
     ],
     [
      "to-number",
      [
       "get",
       "ele"
      ],
      0
     ],
     1000,
     0.4,
     4000,
     1
    ],
    "heatmap-radius": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     18,
     12,
     48
    ],
    "heatmap-intensity": 1.3,
    "heatmap-opacity": 0.85,
    "heatmap-color": [
     "interpolate",
     [
      "linear"
     ],
     [
      "heatmap-density"
     ],
     0,
     "rgba(255,255,255,0)",
     0.25,
     "#ffe08a",
     0.5,
     "#ff9f43",
     0.75,
     "#e4572e",
     1,
     "#8c1c13"
    ]
   },
   "layout": {
    "visibility": "none"
   }
  },
  {
   "id": "peak-circles",
   "type": "circle",
   "source": "ofm",
   "source-layer": "mountain_peak",
   "paint": {
    "circle-radius": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     3,
     12,
     7
    ],
    "circle-color": "#e4572e",
    "circle-stroke-color": "#ffffff",
    "circle-stroke-width": 1.5
   },
   "layout": {
    "visibility": "none"
   }
  },
  {
   "id": "waypoints",
   "type": "circle",
   "source": "wps",
   "paint": {
    "circle-radius": 8,
    "circle-color": "#ffffff",
    "circle-stroke-color": "#b3261e",
    "circle-stroke-width": 3
   },
   "layout": {
    "visibility": "none"
   }
  },
  {
   "id": "waypoint-labels",
   "type": "symbol",
   "source": "wps",
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 14,
    "text-anchor": "bottom",
    "text-offset": [
     0,
     -1.0
    ],
    "visibility": "none"
   },
   "paint": {
    "text-color": "#3b1a17",
    "text-halo-color": "rgba(255,255,255,0.95)",
    "text-halo-width": 2
   }
  },
  {
   "id": "peaks",
   "type": "symbol",
   "source": "ofm",
   "source-layer": "mountain_peak",
   "filter": [
    "has",
    "name"
   ],
   "layout": {
    "icon-image": "mountain",
    "icon-size": 1.3,
    "text-field": [
     "case",
     [
      "has",
      "ele"
     ],
     [
      "concat",
      [
       "coalesce",
       [
        "get",
        "name_en"
       ],
       [
        "get",
        "name"
       ]
      ],
      "\n",
      [
       "to-string",
       [
        "get",
        "ele"
       ]
      ],
      " m"
     ],
     [
      "coalesce",
      [
       "get",
       "name_en"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 13,
    "text-anchor": "top",
    "text-offset": [
     0,
     0.8
    ],
    "text-max-width": 9,
    "symbol-sort-key": [
     "*",
     -1,
     [
      "to-number",
      [
       "get",
       "ele"
      ],
      0
     ]
    ]
   },
   "paint": {
    "text-color": "#1d2433",
    "text-halo-color": "rgba(255,255,255,0.95)",
    "text-halo-width": 1.8
   }
  }
 ]
